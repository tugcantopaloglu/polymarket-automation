[Unit]
Description=Polymarket Arbitrage Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/clawd/projects/polymarket-bot
ExecStart=/root/clawd/projects/polymarket-bot/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

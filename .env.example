# Polymarket Bot Configuration
# Copy this file to .env and fill in your values

# ===========================================
# WALLET CONFIGURATION
# ===========================================
# Your Polygon wallet private key (without 0x prefix)
# PRIVATE_KEY=your_private_key_here

# Optional: Funder address for gas fees
# FUNDER_ADDRESS=0x...

# ===========================================
# NOTIFICATION SETTINGS
# ===========================================
# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=
# Telegram Chat ID (your user ID or group ID)
TELEGRAM_CHAT_ID=

# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# ===========================================
# AI INTEGRATION (Optional)
# ===========================================
# OpenAI API Key for GPT-4 market analysis
OPENAI_API_KEY=

# Anthropic API Key for Claude market analysis
ANTHROPIC_API_KEY=

# ===========================================
# TRADING PARAMETERS
# ===========================================
# Minimum profit margin for arbitrage (0.02 = 2%)
MIN_PROFIT_MARGIN=0.02

# Maximum single position size in USD
MAX_POSITION_USD=50

# Stop trading after this daily loss
MAX_DAILY_LOSS_USD=20

# Minimum market liquidity to trade
MIN_LIQUIDITY_USD=100

# Maximum slippage tolerance
MAX_SLIPPAGE=0.02

# ===========================================
# MONITORING (if using Grafana)
# ===========================================
# Grafana admin password
GRAFANA_PASSWORD=polymarket123
